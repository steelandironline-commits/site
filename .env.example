# ---------------------------------------------------------------------------
# AutoPix — environment variables
# Copy to .env and fill in. Never commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=

# Public URL of the web app (used in activation / reset links and CORS)
APP_URL=http://localhost:5173

# Public URL of the API (used for payment webhooks notification_url)
API_URL=http://localhost:3000

# Secrets (>= 32 chars each in production). Leave empty in development to use
# ephemeral per-process secrets (sessions will not survive restarts).
SESSION_SECRET=
ACTIVATION_TOKEN_SECRET=
PASSWORD_RESET_SECRET=

# mock | mercadopago | asaas | banco_do_brasil | none  (mock is refused when NODE_ENV=production;
# none = no gateway: the app runs, every charge is refused with a clear message)
PAYMENT_PROVIDER=mock
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
# Optional override of the provider API base URL (e.g. Asaas sandbox:
# https://api-sandbox.asaas.com/v3)
PAYMENT_API_URL=
# Development/tests only: extra mock capabilities to exercise every AutoPix Pay
# flow, e.g. protectedFlow,payout  (never available in production)
MOCK_PAYMENT_CAPABILITIES=

# --- Banco do Brasil (PAYMENT_PROVIDER=banco_do_brasil) --------------------
# Credentials come from the BB developer portal (developers.bb.com.br).
# NEVER commit real values. The worker needs everything except BB_WEBHOOK_SECRET.
BB_ENVIRONMENT=sandbox
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_DEVELOPER_APPLICATION_KEY=
# Your Pix key registered at BB (receiving account)
BB_PIX_KEY=
# >= 32 random chars; appended to the registered webhook URL (?token=…)
BB_WEBHOOK_SECRET=
# Defaults: sandbox https://api.hm.bb.com.br/pix/v2 + https://oauth.sandbox.bb.com.br/oauth/token
#           production https://api-pix.bb.com.br/pix/v2 + https://oauth.bb.com.br/oauth/token
# Confirm both against your BB application before going live.
BB_API_BASE_URL=
BB_OAUTH_URL=
BB_OAUTH_SCOPES=
# gw-dev-app-key (sandbox) | gw-app-key (production) — default by environment
BB_APP_KEY_PARAM=
# Optional mTLS client certificate (base64 PEM) if your BB contract requires it
BB_MTLS_CERT_BASE64=
BB_MTLS_KEY_BASE64=
BB_PIX_EXPIRATION_SECONDS=3600
# Contract flags. They only document what is contracted: AutoPix enables a
# capability ONLY when its integration exists (split/payout/BB Pay/protected
# flow are not implemented yet and stay unavailable even when true).
BB_PAY_ENABLED=false
BB_SPLIT_ENABLED=false
BB_PAYOUT_ENABLED=false
BB_PROTECTED_PAYMENT_ENABLED=false

# true  -> fictional companies + DEMO labels (DemoSourceAdapter)
# false -> only real sources, no simulated activity whatsoever
DEMO_MODE=true

# HTTP port for the API (Railway injects PORT automatically)
PORT=3000

# --- Optional -------------------------------------------------------------
# Run the background worker inside the API process (single-service deploys)
EMBEDDED_WORKER=false
# Minutes between automatic searches per active company
SEARCH_INTERVAL_MINUTES=60
# Minimum score (0-100) for a candidate to become an opportunity
OPPORTUNITY_SCORE_THRESHOLD=60

# Search API used by SearchSourceAdapter (brave). Empty = adapter disabled.
SEARCH_PROVIDER=
SEARCH_API_KEY=
# Google News RSS based NewsSourceAdapter (public RSS, no key)
NEWS_SOURCE_ENABLED=false
# BrasilAPI CNPJ lookup used by PublicBusinessSourceAdapter
PUBLIC_BUSINESS_SOURCE_ENABLED=false

# console | resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=AutoPix <nao-responda@autopix.com.br>

# --- WhatsApp Business Platform (Cloud API) -------------------------------
# cloud | mock | disabled. Default: cloud when credentials exist, mock in
# development/test, disabled in production. Mock is never used in production.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret: verifies X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=
# Token you choose; Meta sends it back during webhook verification
WHATSAPP_VERIFY_TOKEN=
# Public business number shown to users for linking (digits, with country code)
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v21.0
# Approved template names for business-initiated notifications (optional)
WHATSAPP_TEMPLATE_OPPORTUNITY=
WHATSAPP_TEMPLATE_PAYMENT=
WHATSAPP_TEMPLATE_FREIGHT=
WHATSAPP_TEMPLATE_WORKFORCE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- Web Push (PWA notifications) -----------------------------------------
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:suporte@seu-dominio.com.br

# rules (deterministic pt-BR parser) | llm (requires wiring an LLM client)
INTENT_PARSER=rules
