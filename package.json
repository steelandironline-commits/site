{
  "name": "autopix",
  "version": "1.0.0",
  "private": true,
  "description": "TemPix — Tem emprego, tem rota, tem serviço.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/areas",
    "packages/ui",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently -k -n api,worker,web -c cyan,magenta,green \"npm run dev -w @autopix/api\" \"npm run dev -w @autopix/worker\" \"npm run dev -w @autopix/web\"",
    "dev:cnpj": "npm run dev:cnpj -w @autopix/web",
    "dev:cpf": "npm run dev:cpf -w @autopix/web",
    "build": "prisma generate && npm run build -w @autopix/web",
    "build:areas": "npm run build:areas -w @autopix/web",
    "start": "node apps/api/src/server.js",
    "start:worker": "node apps/worker/src/index.js",
    "test": "npm test -w @autopix/shared -w @autopix/areas -w @autopix/core -w @autopix/api -w @autopix/web --if-present",
    "test:isolation": "node scripts/test-isolation.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "bb:register-webhook": "node scripts/bb-register-webhook.js",
    "db:studio": "prisma studio",
    "lint": "find apps/api/src apps/worker/src packages/*/src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "vitest": "4.0.18"
  }
}
