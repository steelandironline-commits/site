// TemPix — database schema
// PostgreSQL + Prisma. Money for subscriptions/payments is stored in cents;
// business estimates (ticket, opportunity value) are stored in whole reais.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_PAYMENT
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum SessionScope {
  ONBOARDING
  FULL
}

/// Área de acesso (Tem CNPJ, Tem CPF, admin da plataforma). Só sessões e tokens a gravam: a área
/// de um registro de negócio vem do dono (Company.accountType). Nula = criado antes das áreas.
enum Area {
  CNPJ
  CPF
  ADMIN
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
  CANCELED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  FAILED
  FLAGGED
}

enum TripStatus {
  NOT_STARTED
  EN_ROUTE_PICKUP
  AT_PICKUP
  LOADED
  IN_TRANSIT
  AT_DESTINATION
  DELIVERED
}

enum TripEventType {
  DRIVER_EN_ROUTE_PICKUP
  DRIVER_ARRIVED_PICKUP
  CARGO_LOADED
  TRIP_STARTED
  NEAR_DESTINATION
  DRIVER_ARRIVED_DESTINATION
  DELIVERY_CONFIRMED
  LOCATION_UPDATE
}

enum TransactionType {
  SALES
  FREIGHT
  WORKFORCE
  SERVICE
  SUBSCRIPTION
}

enum TransactionStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  PROTECTED
  READY_TO_RELEASE
  RELEASED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum AllocationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  BUYER_RESPONSE
  SELLER_RESPONSE
  RESOLVED_BUYER
  RESOLVED_SELLER
  CANCELLED
}

enum AuditSource {
  WEB
  PWA
  WHATSAPP
  SYSTEM
  WORKER
  ADMIN
  API
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  AUTO_REPAIRED
}

enum PaymentKind {
  SUBSCRIPTION
  CHARGE
  SIGNUP_FEE
  INTERVIEW_FEE
  HIRING_FEE
}

/// Empresa (CNPJ) or profissional (pessoa física, free signup).
enum AccountType {
  COMPANY
  PERSON
}

enum ProtectionStatus {
  NONE
  HELD
  RELEASE_REQUESTED
  RELEASED
  DISPUTED
  REFUNDED
}

enum ActionChannel {
  WEB
  WHATSAPP
  API
  SYSTEM
}

enum ActionStatus {
  SUCCEEDED
  FAILED
  REJECTED
  CONFIRMATION_REQUIRED
}

enum ChallengeStatus {
  PENDING
  CONFIRMED
  EXECUTED
  FAILED
  EXPIRED
  CANCELED
}

enum WhatsAppConnectionStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
  RECEIVED
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationCategory {
  OPPORTUNITIES
  FREIGHT
  WORKFORCE
  PAYMENTS
  SYSTEM
  AGENTS
}

enum FreightRequestStatus {
  OPEN
  CLOSED
  CANCELED
}

enum FreightMatchStatus {
  NEW
  ACCEPTED
  REJECTED
  DRIVER_ARRIVED
  COMPLETED
  EXPIRED
}

enum WorkforceDemandStatus {
  OPEN
  FILLED
  CANCELED
}

enum WorkforceMatchStatus {
  SUGGESTED
  INVITED
  ACCEPTED
  DECLINED
  COMPLETED
}

enum OpportunityStatus {
  NEW
  RESEARCHING
  CONTACTED
  INTERESTED
  PROPOSAL
  WON
  LOST
  ARCHIVED
}

enum OpportunityPriority {
  HIGH
  MEDIUM
  LOW
}

enum Severity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ActivityType {
  SEARCH
  RESEARCH
  SIGNAL
  OPPORTUNITY
  AGENT
  SYSTEM
  PAYMENT
}

enum AgentKey {
  RADAR
  RESEARCH
  SIGNAL
  SCORING
  SALES
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum JobTrigger {
  PAYMENT
  SCHEDULED
  PROFILE_UPDATE
  MANUAL
}

enum SignalType {
  EXPANSION
  HIRING
  CONSTRUCTION
  PURCHASE
  NEW_PROJECT
  DEMAND
}

enum SourceType {
  DEMO
  SEARCH
  WEBSITE
  NEWS
  PUBLIC_REGISTRY
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerifiedAt   DateTime?
  /// Login: CNPJ (company owner) or CPF (pessoa física, collaborator), digits only.
  loginId           String?    @unique
  name              String
  passwordHash      String?
  status            UserStatus @default(PENDING_PAYMENT)
  /// Unpaid signup (PENDING_PAYMENT) must be finished by this time; then it is purged.
  pendingExpiresAt  DateTime?
  role              UserRole   @default(OWNER)
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  isPlatformAdmin   Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions            Session[]
  loginChallenges     LoginChallenge[]
  whatsappConnection  WhatsAppConnection?
  notificationPrefs   NotificationPreference[]
  pushSubscriptions   PushSubscription[]
  challenges          SensitiveActionChallenge[]
  activationTokens    ActivationToken[]
  passwordResetTokens PasswordResetToken[]
  activityEvents      ActivityEvent[]

  @@index([companyId])
  socialPosts SocialPost[]
  socialComments SocialComment[]

}

model Session {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      SessionScope @default(FULL)
  /// Área em que a sessão vale (o "aud" do token). Nula em sessão antiga: vale só no modo legado.
  area       Area?
  expiresAt  DateTime
  lastSeenAt DateTime     @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  /// Área do host onde o login começou: o código só vale lá.
  area       Area?
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Company {
  id                    String      @id @default(cuid())
  accountType           AccountType @default(COMPANY)
  name                  String
  cnpj                  String?   @unique
  website               String?
  instagram             String?
  phone                 String?
  city                  String?
  state                 String?
  postalCode            String?
  serviceLocations      String[]  @default([])
  serviceRadiusKm       Int?
  description           String?
  products              String[]  @default([])
  services              String[]  @default([])
  idealCustomer         String?
  averageTicket         Int?
  minimumDeal           Int?
  preferredIndustries   String[]  @default([])
  excludedIndustries    String[]  @default([])
  keywords              String[]  @default([])
  /// Structured operational profile (types, objectives, equipment, fleet,
  /// routes, ports, buyer needs...). Shape: @autopix/shared operationalProfileSchema.
  operationalProfile          Json?
  operationalProfileUpdatedAt DateTime?
  agentsPaused          Boolean   @default(false)
  payoutPixKey          String?
  payoutPixKeyType      String?
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  searchConfigVersion   Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users            User[]
  subscription     Subscription?
  payments         Payment[]
  opportunities    Opportunity[]
  activityEvents   ActivityEvent[]
  agentRuns        AgentRun[]
  signals          CompanySignal[]
  searchJobs       SearchJob[]
  domainEvents     DomainEvent[]
  actionLogs       ActionLog[]
  freightRequests  FreightRequest[]
  freightMatches   FreightMatch[]
  workforceDemands WorkforceDemand[]
  workforceMatches WorkforceMatch[]

}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @unique
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                   String             @default("AUTOPIX")
  priceCents             Int
  status                 SubscriptionStatus @default(PENDING)
  provider               String
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  activatedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payments Payment[]

  @@index([status, currentPeriodEnd])
}

model Payment {
  id                   String                  @id @default(cuid())
  subscriptionId       String?
  subscription         Subscription?           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind                 PaymentKind             @default(SUBSCRIPTION)
  reference            String?                 @unique
  description          String?
  payerName            String?
  payerDocument        String?
  payerEmail           String?
  protectionStatus     ProtectionStatus        @default(NONE)
  releasedAt           DateTime?
  refundedAt           DateTime?
  disputeReason        String?
  relatedType          String?
  relatedId            String?
  createdByUserId      String?
  txid                 String?
  isSandbox            Boolean                 @default(false)
  refundedCents        Int                     @default(0)
  failureCode          String?
  transactionId        String?                 @unique
  transaction          MarketplaceTransaction? @relation("TransactionPayment", fields: [transactionId], references: [id], onDelete: SetNull)
  allocations          PaymentAllocation[]
  refunds              Refund[]
  reconciliationIssues ReconciliationIssue[]
  companyId            String
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider             String
  providerPaymentId    String?
  amountCents          Int
  currency             String                  @default("BRL")
  method               String                  @default("PIX")
  status               PaymentStatus           @default(PENDING)
  pixQrCodeBase64      String?
  pixCopyPaste         String?
  expiresAt            DateTime?
  paidAt               DateTime?
  idempotencyKey       String                  @unique
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  events PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([companyId, createdAt])
  @@index([status])
}

model PaymentEvent {
  id                String             @id @default(cuid())
  paymentId         String?
  payment           Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider          String
  providerEventId   String
  providerPaymentId String?
  type              String
  status            String?
  processed         Boolean            @default(false)
  processingStatus  PaymentEventStatus @default(RECEIVED)
  payload           Json?
  payloadHash       String?
  metadata          Json?
  error             String?
  createdAt         DateTime           @default(now())
  processedAt       DateTime?

  @@unique([provider, providerEventId])
  @@index([processingStatus, createdAt])
  @@index([providerPaymentId])
}

model Opportunity {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetKey         String
  targetCompanyName String
  targetWebsite     String?
  industry          String?
  city              String?
  state             String?
  score             Int
  confidence        Float
  priority          OpportunityPriority @default(MEDIUM)
  signal            String
  signalType        SignalType?
  description       String?
  reasons           String[]            @default([])
  matchingServices  String[]            @default([])
  estimatedMinValue Int?
  estimatedMaxValue Int?
  suggestedApproach String?
  notes             String?
  status            OpportunityStatus   @default(NEW)
  isDemo            Boolean             @default(false)
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sources        OpportunitySource[]
  contacts       Contact[]
  signals        CompanySignal[]
  activityEvents ActivityEvent[]

  @@unique([companyId, targetKey])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, score])
}

model OpportunitySource {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          SourceType
  title         String
  url           String?
  snippet       String?
  retrievedAt   DateTime    @default(now())

  @@index([opportunityId])
}

model ActivityEvent {
  id            String       @id @default(cuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  jobId         String?
  type          ActivityType
  title         String
  description   String?
  source        String?
  severity      Severity     @default(INFO)
  isDemo        Boolean      @default(false)
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@index([type])
  @@index([companyId, createdAt])
}

model Agent {
  id          String   @id @default(cuid())
  key         AgentKey @unique
  name        String
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs           AgentRun[]
  activityEvents ActivityEvent[]
}

model AgentRun {
  id         String     @id @default(cuid())
  agentId    String
  agent      Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId      String?
  job        SearchJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status     RunStatus  @default(RUNNING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?
  metrics    Json?
  metadata   Json?

  @@index([companyId, startedAt])
  @@index([agentId, startedAt])
  @@index([jobId])
}

model CompanySignal {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  targetCompanyName String
  type              SignalType
  title             String
  description       String?
  strength          Float
  sourceUrl         String?
  isDemo            Boolean      @default(false)
  detectedAt        DateTime     @default(now())

  @@index([companyId, detectedAt])
  @@index([opportunityId])
}

model Contact {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  name          String?
  role          String?
  companyPhone  String?
  businessEmail String?
  linkedinUrl   String?
  publicSource  String
  verified      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
}

model ActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  emailSentAt DateTime?
  /// Área do link. Nula em token antigo: vale a área do dono.
  area      Area?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// Área do link. Nula em token antigo: vale a área do dono.
  area      Area?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SearchJob {
  id                   String     @id @default(cuid())
  companyId            String
  company              Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status               JobStatus  @default(QUEUED)
  trigger              JobTrigger @default(SCHEDULED)
  runAt                DateTime   @default(now())
  attempts             Int        @default(0)
  maxAttempts          Int        @default(3)
  lockedAt             DateTime?
  lockedBy             String?
  startedAt            DateTime?
  finishedAt           DateTime?
  error                String?
  configVersion        Int        @default(1)
  isDemo               Boolean    @default(false)
  companiesAnalyzed    Int        @default(0)
  signalsDetected      Int        @default(0)
  opportunitiesCreated Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  agentRuns AgentRun[]

  @@index([status, runAt])
  @@index([companyId, createdAt])
}

// ===================================================================
// Platform layer: domain events, actions, challenges, channels
// ===================================================================

model DomainEvent {
  id            String    @id @default(cuid())
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String?
  type          String
  aggregateType String?
  aggregateId   String?
  payload       Json?
  isDemo        Boolean   @default(false)
  attempts      Int       @default(0)
  lockedAt      DateTime?
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([processedAt, createdAt])
  @@index([companyId, createdAt])
  @@index([type])
}

model ActionLog {
  id          String        @id @default(cuid())
  action      String
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId String?
  channel     ActionChannel
  status      ActionStatus
  input       Json?
  result      Json?
  error       String?
  challengeId String?
  ipAddress   String?
  durationMs  Int?
  createdAt   DateTime      @default(now())

  @@index([companyId, createdAt])
  @@index([action])
}

model SensitiveActionChallenge {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String
  action             String
  input              Json
  summary            String
  requestedVia       ActionChannel
  status             ChallengeStatus @default(PENDING)
  mechanism          String          @default("WEB_PASSWORD")
  verificationCodeHash String?
  attempts           Int             @default(0)
  expiresAt          DateTime
  confirmedAt        DateTime?
  confirmedSessionId String?
  result             Json?
  createdAt          DateTime        @default(now())

  @@index([userId, status])
}

model WhatsAppConnection {
  id                    String                   @id @default(cuid())
  userId                String                   @unique
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber           String                   @unique
  provider              String
  providerContactId     String?
  verifiedAt            DateTime?
  status                WhatsAppConnectionStatus @default(PENDING)
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  messages        WhatsAppMessage[]
  pendingCommands WhatsAppPendingCommand[]
}

model WhatsAppMessage {
  id                String              @id @default(cuid())
  connectionId      String?
  connection        WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  direction         MessageDirection
  phoneNumber       String
  kind              String
  body              Json?
  providerMessageId String?             @unique
  status            MessageStatus
  error             String?
  domainEventId     String?
  createdAt         DateTime            @default(now())

  @@index([connectionId, createdAt])
}

model WhatsAppPendingCommand {
  id           String             @id @default(cuid())
  connectionId String
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  intent       String
  params       Json
  summary      String
  status       String             @default("PENDING")
  expiresAt    DateTime
  createdAt    DateTime           @default(now())

  @@index([connectionId, status])
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  category  NotificationCategory
  enabled   Boolean
  updatedAt DateTime             @updatedAt

  @@unique([userId, channel, category])
}

model NotificationDelivery {
  id            String              @id @default(cuid())
  domainEventId String
  domainEvent   DomainEvent         @relation(fields: [domainEventId], references: [id], onDelete: Cascade)
  userId        String
  channel       NotificationChannel
  status        MessageStatus
  error         String?
  createdAt     DateTime            @default(now())

  @@unique([domainEventId, userId, channel])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------- freight

model FreightRequest {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  date        DateTime?
  cargo       String?
  status      FreightRequestStatus @default(OPEN)
  isDemo      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  matches FreightMatch[]

  @@index([companyId, createdAt])
}

model FreightMatch {
  id                    String             @id @default(cuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId             String?
  request               FreightRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  origin                String
  destination           String
  pickupDate            DateTime?
  cargo                 String?
  weightKg              Int?
  price                 Int?
  isReturnLoad          Boolean            @default(false)
  carrierName           String?
  pickupLat             Float?
  pickupLng             Float?
  destLat               Float?
  destLng               Float?
  tripStatus            TripStatus         @default(NOT_STARTED)
  trackingConsentAt     DateTime?
  trackingConsentUserId String?
  source                String
  status                FreightMatchStatus @default(NEW)
  isDemo                Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tripEvents TripEvent[]

  @@index([companyId, status])
}

// --------------------------------------------------------- workforce

model WorkforceDemand {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String
  quantity  Int
  startDate DateTime?
  location  String?
  notes     String?
  status    WorkforceDemandStatus @default(OPEN)
  isDemo    Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  matches WorkforceMatch[]

  @@index([companyId, createdAt])
}

model WorkforceMatch {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  demandId         String
  demand           WorkforceDemand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  professionalName String
  role             String
  city             String?
  experienceYears  Int?
  rating           Float?
  source           String
  status           WorkforceMatchStatus @default(SUGGESTED)
  interviewScheduledAt DateTime?
  interviewCandidateEmail String?
  interviewFeePaidAt DateTime?
  interviewCanceledAt DateTime?
  agreedSalaryCents Int?
  hiringFeePaidAt DateTime?
  isDemo           Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([companyId, status])
  @@index([demandId])
}

// ===================================================================
// TemPix Pay — marketplace financial layer (provider-independent)
// ===================================================================

model MarketplaceTransaction {
  id                 String            @id @default(cuid())
  type               TransactionType
  status             TransactionStatus @default(DRAFT)
  description        String
  sellerCompanyId    String
  sellerUserId       String?
  buyerCompanyId     String?
  buyerUserId        String?
  buyerName          String?
  buyerEmail         String?
  referenceType      String?
  referenceId        String?
  grossAmount        Int
  commissionAmount   Int
  providerFeesAmount Int               @default(0)
  sellerNetAmount    Int
  commissionRuleId   String?
  commissionRateBps  Int
  currency           String            @default("BRL")
  protectedFlow      Boolean           @default(false)
  settlementStatus   String            @default("NOT_APPLICABLE")
  serviceStartedAt   DateTime?
  sellerCompletedAt  DateTime?
  buyerConfirmedAt   DateTime?
  releasedAt         DateTime?
  cancelledAt        DateTime?
  isSandbox          Boolean           @default(false)
  isDemo             Boolean           @default(false)
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  payment  Payment?             @relation("TransactionPayment")
  timeline TransactionEvent[]
  disputes TransactionDispute[]
  payouts  Payout[]
  socialPosts SocialPost[]

  @@index([sellerCompanyId, createdAt])
  @@index([buyerCompanyId, createdAt])
  @@index([status])
  @@index([referenceType, referenceId])
}

model TransactionEvent {
  id            String                 @id @default(cuid())
  transactionId String
  transaction   MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type          String
  title         String
  actorUserId   String?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([transactionId, createdAt])
}

model CommissionRule {
  id               String           @id @default(cuid())
  name             String
  transactionType  TransactionType?
  companyId        String?
  rateBps          Int
  fixedAmountCents Int              @default(0)
  minimumCents     Int?
  maximumCents     Int?
  currency         String           @default("BRL")
  active           Boolean          @default(true)
  priority         Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([active, transactionType])
}

model PaymentAllocation {
  id                   String           @id @default(cuid())
  paymentId            String
  payment              Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  beneficiaryType      String
  beneficiaryReference String
  grossShare           Int
  netShare             Int
  providerAllocationId String?
  status               AllocationStatus @default(PENDING)
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([paymentId])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionId     String?
  amountCents       Int
  reason            String?
  status            RefundStatus @default(REQUESTED)
  providerRefundId  String?
  idempotencyKey    String       @unique
  requestedByUserId String?
  error             String?
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([status, createdAt])
}

model Payout {
  id               String                 @id @default(cuid())
  transactionId    String
  transaction      MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amountCents      Int
  status           PayoutStatus           @default(REQUESTED)
  providerPayoutId String?
  idempotencyKey   String                 @unique
  error            String?
  createdAt        DateTime               @default(now())
  completedAt      DateTime?

  @@index([status])
}

model TransactionDispute {
  id               String                 @id @default(cuid())
  transactionId    String
  transaction      MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  openedByUserId   String
  reason           String
  description      String?
  status           DisputeStatus          @default(OPEN)
  metadata         Json?
  resolvedByUserId String?
  resolutionNote   String?
  createdAt        DateTime               @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
}

/// Append-only (UPDATE/DELETE blocked by a database trigger).
model FinancialAuditLog {
  id            String      @id @default(cuid())
  userId        String?
  companyId     String?
  transactionId String?
  paymentId     String?
  action        String
  source        AuditSource
  ipAddressHash String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([transactionId])
  @@index([paymentId])
}

model ReconciliationIssue {
  id               String      @id @default(cuid())
  paymentId        String?
  payment          Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundId         String?
  kind             String
  localStatus      String?
  providerStatus   String?
  details          Json?
  status           IssueStatus @default(OPEN)
  resolvedByUserId String?
  resolutionNote   String?
  createdAt        DateTime    @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([paymentId, kind])
}

model TripEvent {
  id               String        @id @default(cuid())
  freightMatchId   String
  freightMatch     FreightMatch  @relation(fields: [freightMatchId], references: [id], onDelete: Cascade)
  companyId        String
  type             TripEventType
  latitude         Float?
  longitude        Float?
  accuracyM        Float?
  source           String
  recordedByUserId String?
  createdAt        DateTime      @default(now())

  @@index([freightMatchId, createdAt])
}


// Social publications contain only the opinion and photo explicitly shared.
model SocialPost {
  id               String @id @default(cuid())
  transactionId    String?
  transaction      MarketplaceTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  authorUserId     String
  author           User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body             String
  photo            String?
  repostOfId       String?
  repostOf         SocialPost? @relation("SocialReposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts          SocialPost[] @relation("SocialReposts")
  comments         SocialComment[]
  deletedAt        DateTime?
  createdAt        DateTime @default(now())

  @@unique([transactionId, authorUserId])
  @@unique([repostOfId, authorUserId])
  @@index([createdAt, id])
}

model SocialComment {
  id           String @id @default(cuid())
  postId       String
  post         SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  parentId     String?
  parent       SocialComment? @relation("SocialReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      SocialComment[] @relation("SocialReplies")
  createdAt    DateTime @default(now())

  @@index([postId, createdAt])
}

/// Public procurement notices (licitações / contratações) from open official sources (PNCP).
/// Shared by every company account; refreshed by the worker.
model PublicTender {
  id                String    @id @default(cuid())
  source            String    @default("pncp")
  externalId        String    @unique // numeroControlePNCP
  agencyName        String
  agencyCnpj        String?
  sphere            String? // F federal, E estadual, M municipal, N não informado
  unitName          String?
  city              String?
  cityIbge          String?
  state             String?
  object            String
  modality          String?
  modalityId        Int?
  disputeMode       String?
  situationId       Int?
  situationName     String?
  estimatedCents    BigInt?
  proposalOpensAt   DateTime?
  proposalClosesAt  DateTime?
  publishedAt       DateTime?
  sourceUpdatedAt   DateTime?
  url               String
  lastSeenAt        DateTime  @default(now())
  /// Left the source's list of open notices before its deadline (suspended, revoked…).
  leftOpenListAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([state, city])
  @@index([proposalClosesAt])
  @@index([publishedAt])
}

/// Vagas de emprego públicas da área CPF (Adzuna, feeds e DEMO). Sem dono: não pertencem a uma empresa nem a uma
/// pessoa; quem pode ver cada vaga sai da área dela (packages/shared/src/jobs/visibility.js). Apagadas após 60 dias.
model JobListing {
  id              String    @id @default(cuid())
  /// ADZUNA | FEED | DEMO
  source          String
  externalId      String
  title           String
  company         String?
  city            String?
  state           String?
  /// slug de packages/shared/src/jobs/areas.js
  area            String
  /// Em reais. Faixa ou valor único; o período diz se é por mês, hora ou dia.
  salaryMin       Decimal?  @db.Decimal(12, 2)
  salaryMax       Decimal?  @db.Decimal(12, 2)
  /// MES | HORA | DIA
  salaryPeriod    String?
  salaryText      String?
  description     String    @db.Text
  contactWhatsapp String?
  contactEmail    String?
  sourceUrl       String
  postedAt        DateTime
  /// Só quando a fonte informa. Nunca é inventado.
  expiresAt       DateTime?
  /// BOM | VERIFIQUE | ATENCAO
  scoreLevel      String
  scoreValue      Int
  scoreReasons    Json
  fetchedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@unique([source, externalId])
  @@index([area])
  @@index([postedAt])
}

/// Bookkeeping for background syncs (one row per job): lease, last run, last result.
model SyncState {
  key           String    @id
  leaseUntil    DateTime?
  lastStartedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  stats         Json?
  updatedAt     DateTime  @updatedAt
}
